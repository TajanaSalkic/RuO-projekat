# Auto detect text files and perform LF normalization
* text=auto

*.sh      text eol=lf
*.bash    text eol=lf
Makefile  text eol=lf
*.tf      text eol=lf
*.tftpl   text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.nft     text eol=lf
*.j2      text eol=lf
*.conf    text eol=lf
*.sql     text eol=lf
